# Astro build config (defaults: site=https://vesper.pm, base=/)
# To host a copy elsewhere, set ASTRO_SITE to its canonical URL. Keep ASTRO_BASE=/ (the deploy refuses a sub-path).
# ASTRO_SITE=https://vesper.pm
# ASTRO_BASE=/

# ElevenLabs TTS (optional — only needed for audio generation)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_EN=
# ELEVENLABS_VOICE_FR=
