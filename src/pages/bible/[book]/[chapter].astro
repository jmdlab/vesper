---
import AppLayout from '../../../layouts/AppLayout.astro'
import { ChapterReaderClient } from '../../../components/ChapterReaderClient'
import { readFileSync } from 'fs'
import { resolve } from 'path'

const BIBLE_DIR = resolve(process.cwd(), 'src/content/bible')
const booksIndex = JSON.parse(readFileSync(resolve(BIBLE_DIR, '_books.json'), 'utf-8'))

export function getStaticPaths() {
  const BIBLE_DIR = resolve(process.cwd(), 'src/content/bible')
  const booksIndex = JSON.parse(readFileSync(resolve(BIBLE_DIR, '_books.json'), 'utf-8'))

  const paths = []
  for (const book of booksIndex) {
    for (let ch = 1; ch <= book.chapterCount; ch++) {
      paths.push({ params: { book: book.slug, chapter: String(ch) } })
    }
  }
  return paths
}

const { book: bookSlug, chapter: chapterStr } = Astro.params
const chapterNum = parseInt(chapterStr!)
const bookMeta = booksIndex.find((b: any) => b.slug === bookSlug)

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

if (!bookMeta) {
  return Astro.redirect(`${base}/bible`)
}

const bookData = JSON.parse(readFileSync(resolve(BIBLE_DIR, `${bookSlug}.json`), 'utf-8'))
const verses = bookData.chapters[String(chapterNum)] ?? []

// SEO: unique description from verse 1, breadcrumb + chapter structured data
const verse1: string = verses[0]?.textEn ?? ''
const excerpt = verse1.length > 100 ? `${verse1.slice(0, 100).trimEnd()}…` : verse1
const description = `${bookMeta.nameEn} ${chapterNum} — read and listen. ${excerpt}`.trim()
const bookUrl = `https://vesper.pm/bible/${bookSlug}/`
const chapterUrl = `${bookUrl}${chapterNum}/`
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Bible', item: 'https://vesper.pm/bible/' },
      { '@type': 'ListItem', position: 2, name: bookMeta.nameEn, item: bookUrl },
      { '@type': 'ListItem', position: 3, name: `Chapter ${chapterNum}`, item: chapterUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Chapter',
    name: `${bookMeta.nameEn} ${chapterNum}`,
    url: chapterUrl,
    isPartOf: { '@type': 'Book', name: bookMeta.nameEn, url: bookUrl },
  },
]
---

<AppLayout title={`${bookMeta.nameEn} ${chapterNum} — Vesper`} description={description} jsonLd={jsonLd}>
  <ChapterReaderClient
    client:load
    book={bookMeta}
    chapter={chapterNum}
    verses={verses}
  />
</AppLayout>
