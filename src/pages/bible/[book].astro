---
import AppLayout from '../../layouts/AppLayout.astro'
import { ChapterGridClient } from '../../components/ChapterGridClient'
import { readFileSync } from 'fs'
import { resolve } from 'path'

const BIBLE_DIR = resolve(process.cwd(), 'src/content/bible')
const booksIndex = JSON.parse(readFileSync(resolve(BIBLE_DIR, '_books.json'), 'utf-8'))

export function getStaticPaths() {
  const BIBLE_DIR = resolve(process.cwd(), 'src/content/bible')
  const booksIndex = JSON.parse(readFileSync(resolve(BIBLE_DIR, '_books.json'), 'utf-8'))

  return booksIndex.map((book: any) => ({
    params: { book: book.slug },
  }))
}

const { book: bookSlug } = Astro.params
const bookMeta = booksIndex.find((b: any) => b.slug === bookSlug)

const base = import.meta.env.BASE_URL.replace(/\/$/, '')

if (!bookMeta) {
  return Astro.redirect(`${base}/bible`)
}

// SEO: unique description + book structured data
const description = `The Book of ${bookMeta.nameEn} — ${bookMeta.chapterCount} chapters, read and listen on Vesper.`
const bookUrl = `https://vesper.pm/bible/${bookSlug}/`
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Bible', item: 'https://vesper.pm/bible/' },
      { '@type': 'ListItem', position: 2, name: bookMeta.nameEn, item: bookUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Book',
    name: bookMeta.nameEn,
    url: bookUrl,
    isPartOf: { '@type': 'CreativeWork', name: 'The Bible', url: 'https://vesper.pm/bible/' },
  },
]
---

<AppLayout title={`${bookMeta.nameEn} — Vesper`} description={description} jsonLd={jsonLd}>
  <ChapterGridClient client:only="react" book={bookMeta} />
</AppLayout>
